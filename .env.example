CMS_LOGIN=ALAB
CMS_PASSWORD=ALAB

# Токен Figma для импорта макетов (не хранить в settings.json!)
FIGMA_TOKEN=
# Соль для анонимизации IP в аналитике
ANALYTICS_SALT=

# Вход в редактор без пароля на своём компьютере: экран логина не показывается.
# Сервер и так слушает только 127.0.0.1 (наружу не виден). Чтобы вернуть пароль —
# удалите строку или поставьте 0 и перезапустите редактор.
# CMS_SKIP_AUTH=1
